# Copy to ".env" locally, OR paste these into Render → Environment.
# Leave any value blank to skip that feature.

PORT=4242

# Live store URL (trailing slash). Used for Stripe success/cancel fallbacks.
SITE_URL=https://yoloscripts.onrender.com/

# Shared secret — must match Devmode → Integrations → Admin API Key.
# Use a long random string (see README for the one generated for this project).
ADMIN_KEY=

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Discord OAuth2 (Developer Portal → OAuth2 → General)
# Client ID is also baked into index.html for browser login.
# Client Secret is server-only — never put it in HTML.
DISCORD_CLIENT_ID=1535016417940869140
DISCORD_CLIENT_SECRET=

# Discord bot (for automatic role grants after purchase)
# Bot needs Manage Roles and must sit ABOVE roles it grants.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# SMTP for order confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@your-domain.com

# Optional — email yourself on every sale
ADMIN_NOTIFY_EMAIL=
